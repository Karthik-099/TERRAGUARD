# TerraGuard configuration. Copy to .env (git-ignored) and fill in only what you need.
# The engine (scan, fix, validate, gate) needs NOTHING here. AI is optional and advisory.

# ── Hosted AI — free tiers only, $0. Any subset; TerraGuard falls back across them. ──
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys   (":free" models cost nothing)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey

# ── Private / local AI: nothing leaves your machine ──
# TERRAGUARD_OLLAMA_URL=http://localhost:11434/v1
# TERRAGUARD_OLLAMA_MODEL=llama3.2
# TERRAGUARD_AI_LOCAL_ONLY=true          # never call hosted providers even if keys exist
# Any OpenAI-compatible server (LM Studio, vLLM, LiteLLM):
# TERRAGUARD_AI_BASE_URL=http://localhost:1234/v1
# TERRAGUARD_AI_MODEL=qwen2.5-coder
# TERRAGUARD_AI_KEY=

# ── Routing (optional) ──
# TERRAGUARD_AI_PROVIDER=openrouter       # try this provider first
# TERRAGUARD_AI_ROUTE=groq:openai/gpt-oss-120b,openrouter,gemini:gemini-2.5-flash

# ── Self-hosted server (terraguard serve) ──
# TERRAGUARD_SERVER_TOKEN=change-me       # required if you listen on anything but localhost

# ── Usage counters (off unless set; anonymous numbers only) ──
# TERRAGUARD_TELEMETRY_URL=https://terraguard-stats.<you>.workers.dev
