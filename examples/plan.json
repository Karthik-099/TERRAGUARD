{
  "format_version": "1.2",
  "terraform_version": "1.9.5",
  "resource_changes": [
    {
      "address": "aws_db_instance.main",
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "main",
      "change": {
        "actions": ["delete", "create"],
        "after": {
          "identifier": "prod-db",
          "engine": "postgres",
          "publicly_accessible": true,
          "storage_encrypted": true,
          "deletion_protection": false,
          "backup_retention_period": 7
        },
        "replace_paths": [["engine_version"], ["identifier"]]
      }
    },
    {
      "address": "aws_s3_bucket.logs",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "logs",
      "change": { "actions": ["delete"], "after": null }
    },
    {
      "address": "aws_security_group.web",
      "mode": "managed",
      "type": "aws_security_group",
      "name": "web",
      "change": {
        "actions": ["update"],
        "after": {
          "name": "web",
          "ingress": [
            { "from_port": 0, "to_port": 0, "protocol": "-1", "cidr_blocks": ["0.0.0.0/0"], "ipv6_cidr_blocks": [] }
          ]
        }
      }
    },
    {
      "address": "aws_instance.web",
      "mode": "managed",
      "type": "aws_instance",
      "name": "web",
      "change": {
        "actions": ["create"],
        "after": { "instance_type": "t3.micro", "metadata_options": [ { "http_tokens": "optional" } ] }
      }
    },
    {
      "address": "aws_iam_policy.ci",
      "mode": "managed",
      "type": "aws_iam_policy",
      "name": "ci",
      "change": {
        "actions": ["create"],
        "after": { "name": "ci", "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"}]}" }
      }
    }
  ]
}
