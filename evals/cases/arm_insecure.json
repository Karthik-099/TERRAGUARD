{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "adminPassword": {"type": "secureString", "defaultValue": "Sup3rS3cretPassw0rd"}
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "Bad_Name",
      "location": "eastus",
      "sku": {"name": "Standard_LRS"},
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": false,
        "minimumTlsVersion": "TLS1_0",
        "networkAcls": {"defaultAction": "Allow"}
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-04-01",
      "name": "web-nsg",
      "location": "eastus",
      "properties": {
        "securityRules": [
          {"name": "rdp", "properties": {"access": "Allow", "direction": "Inbound", "protocol": "*", "priority": 100,
            "sourceAddressPrefix": "*", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "3389"}}
        ]
      }
    },
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2024-02-01",
      "name": "aks1",
      "location": "eastus",
      "properties": {
        "enableRBAC": false,
        "agentPoolProfiles": [{"name": "pool", "count": 2, "vmSize": "Standard_D4s_v5", "mode": "System"}]
      }
    }
  ]
}
